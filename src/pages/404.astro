---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  titleFull="Page not found — RentLedger"
  description="The page you're looking for doesn't exist. Head back to RentLedger's homepage or check the support FAQ."
  noindex
>
  <section
    style="min-height: calc(100vh - 200px); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 6rem 1.5rem; text-align: center;"
  >
    <p
      class="section-tag"
      style="color: var(--rl-primary); margin-bottom: 1rem;"
    >
      404 · Page Not Found
    </p>
    <h1 class="hero-title" style="max-width: 680px; margin-bottom: 1.25rem;">
      This page doesn't exist. <em style="color: var(--rl-primary);"
        >But your rental records could.</em
      >
    </h1>
    <p class="lede" style="max-width: 520px; margin-bottom: 2.5rem;">
      You followed a link that went nowhere. It happens. Your rent payments,
      expenses, and Schedule E reports, though — those can live somewhere
      organized.
    </p>
    <div
      style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; margin-bottom: 3rem;"
    >
      <a href="/" class="btn btn-primary">Back to homepage</a>
      <a
        href="https://apps.apple.com/us/app/rentledger-rental-expense-log/id6761083476"
        class="btn btn-ghost"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="none"
          aria-hidden="true"
          ><path
            d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
          ></path></svg
        >
        Get the App
      </a>
    </div>
  </section>
</BaseLayout>
