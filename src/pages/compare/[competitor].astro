---
import CompareLayout from "../../layouts/CompareLayout.astro";
import TaxDisclaimer from "../../components/TaxDisclaimer.astro";
import AuthorQualification from "../../components/AuthorQualification.astro";
import EditorialOnlyNotice from "../../components/EditorialOnlyNotice.astro";
import { competitors } from "../../data/competitors";
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import "../../styles/blog-post.css";

// Routing model per SEO-PLAYBOOK §M2.2:
//
//   1. Every competitor in src/data/competitors.ts produces a /compare/<slug>/
//      route — either a hand-written narrative (collection entry exists) or
//      a placeholder shell (entry absent).
//   2. When src/content/compare/<slug>.mdx exists AND its competitorSlug
//      matches, render that MDX body inside CompareLayout using the
//      editorial .bp-* shell from blog-post.css. The page is indexable.
//   3. Otherwise render the placeholder shell — still noindex per
//      competitors.ts.placeholder; ships only enough metadata to satisfy
//      the §12.7 audit.
//
// Slot 2 (/compare/quickbooks) is the first comparison page to take the
// MDX path. Slots 3 / 4 (Stessa, Landlordy) follow the same pattern.

export const getStaticPaths = (async () => {
  const entries = await getCollection("compare", ({ data }) => !data.draft);
  const entriesBySlug = new Map(
    entries.map((entry) => [entry.data.competitorSlug, entry]),
  );

  return Object.values(competitors).map((c) => ({
    params: { competitor: c.slug },
    props: { competitor: c, entry: entriesBySlug.get(c.slug) ?? null },
  }));
}) satisfies GetStaticPaths;

interface Props {
  competitor: (typeof competitors)[keyof typeof competitors];
  entry: CollectionEntry<"compare"> | null;
}

const { competitor, entry } = Astro.props;
const path = `/compare/${competitor.slug}/`;
const today = new Date().toISOString().slice(0, 10);

// Branch A: hand-written MDX exists → editorial render.
if (entry) {
  // Cast keeps TS happy with the inline branch.
}

const datePublishedIso = entry
  ? entry.data.pubDate.toISOString()
  : `${today}T00:00:00.000Z`;
const dateModifiedIso = entry
  ? (entry.data.updatedDate ?? entry.data.pubDate).toISOString()
  : `${today}T00:00:00.000Z`;
const datePublished = datePublishedIso.slice(0, 10);
const dateModified = dateModifiedIso.slice(0, 10);

const breadcrumbs = entry?.data.breadcrumbs ?? [
  { name: "Home", path: "/" },
  { name: "Compare", path: "/compare/" },
  { name: `RentLedger vs ${competitor.name}` },
];

const placeholderFaqs = [
  {
    question: `How is RentLedger different from ${competitor.name}?`,
    answer:
      "Placeholder. Real answer compares core positioning (local-first, iOS-only, Lifetime pricing) against this competitor during the comparison sprint.",
  },
  {
    question: `Should I switch from ${competitor.name} to RentLedger?`,
    answer:
      "Placeholder. Real answer covers migration, data export, and the trade-offs during the comparison sprint.",
  },
  {
    question: `Is RentLedger cheaper than ${competitor.name}?`,
    answer: `${competitor.pricingSnapshot}. RentLedger is $4.99/mo, $39.99/yr, or $79.99 lifetime — same features at every tier.`,
  },
  {
    question: `Does ${competitor.name} support Schedule E?`,
    answer:
      "Placeholder. Real answer documents whether and how this competitor supports IRS Schedule E export during the comparison sprint.",
  },
];

const faqs = entry?.data.faqs ?? placeholderFaqs;
const reviewBody =
  entry?.data.reviewBody ??
  `${competitor.tagline} Full hand-written comparison narrative ships during the M3.3 comparison sprint.`;

const title = entry?.data.title ?? `RentLedger vs ${competitor.name}`;
const titleFull =
  entry?.data.titleFull ??
  `RentLedger vs ${competitor.name} — Which Rental Tracker Wins?`;
const description =
  entry?.data.description ??
  `Side-by-side comparison: RentLedger vs ${competitor.name}. Pricing, Schedule E support, privacy posture, platform fit. Updated ${today}.`;
const heroImage = entry?.data.heroImage;

// noindex contract: collection entry overrides the data-file flag. If the
// entry is present and not a draft, the page is indexable; otherwise fall
// back to the data-file's placeholder flag.
const noindex = entry ? false : competitor.placeholder;

// Reading time + TOC only matter for the editorial render path.
let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;
let tocItems: { slug: string; text: string; num: string }[] = [];
let readingMinutes = 0;
let lastVerifiedLabel = "";
const author = entry?.data.author ?? "Praneet Soni";

if (entry) {
  const rendered = await render(entry);
  Content = rendered.Content;
  const headings = rendered.headings;
  tocItems = headings
    .filter((h) => h.depth === 2)
    .map((h, i) => ({
      slug: h.slug,
      text: h.text,
      num: String(i + 1).padStart(2, "0"),
    }));
  const wordCount = entry.body
    ? Math.max(1, Math.round(entry.body.length / 5))
    : 0;
  readingMinutes = Math.max(1, Math.round(wordCount / 220));
  lastVerifiedLabel = new Date(dateModified).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });
}
---

<CompareLayout
  title={title}
  titleFull={titleFull}
  description={description}
  canonicalPath={path}
  heroImage={heroImage}
  datePublished={datePublished}
  dateModified={dateModified}
  competitor={{ name: competitor.name, sameAs: competitor.sameAs }}
  reviewBody={reviewBody}
  reviewRating={entry?.data.reviewRating}
  faqs={faqs}
  breadcrumbs={breadcrumbs}
  noindex={noindex}
>
  {
    entry && Content ? (
      <div class="blog-post">
        <div class="bp-progress" aria-hidden="true">
          <div class="bp-progress__bar" id="bp-progress-bar" />
        </div>

        <div class="bp-shell">
          <article class="bp-article">
            <nav class="bp-breadcrumbs" aria-label="Breadcrumb">
              {breadcrumbs.map((crumb, i) => (
                <Fragment>
                  {crumb.path ? (
                    <a href={crumb.path}>{crumb.name}</a>
                  ) : (
                    <span aria-current="page">{crumb.name}</span>
                  )}
                  {i < breadcrumbs.length - 1 && (
                    <span class="bp-breadcrumbs__sep" aria-hidden="true">
                      /
                    </span>
                  )}
                </Fragment>
              ))}
            </nav>

            <header>
              <span class="bp-eyebrow">Comparison</span>
              <h1 class="bp-title">{entry.data.title}</h1>
              <p class="bp-lede">{entry.data.description}</p>

              <div class="bp-meta" role="contentinfo">
                <span class="bp-meta__item">
                  <span class="bp-meta__label">By</span>
                  <span class="bp-meta__value">{author}</span>
                </span>
                <span class="bp-meta__item">
                  <span class="bp-meta__label">Last verified</span>
                  <span class="bp-meta__value bp-meta__verified">
                    {lastVerifiedLabel}
                  </span>
                </span>
                <span class="bp-meta__item">
                  <span class="bp-meta__label">Read</span>
                  <span class="bp-meta__value">{readingMinutes} min</span>
                </span>
              </div>
            </header>

            {heroImage && (
              <figure class="bp-hero">
                <img
                  src={heroImage}
                  alt=""
                  width="1200"
                  height="630"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </figure>
            )}

            <div class="bp-body" id="bp-body">
              <Content />
            </div>

            <footer class="bp-footer">
              <div class="bp-footer__row">
                <a
                  class="bp-share-btn"
                  href="/blog/rss.xml"
                  aria-label="Subscribe to blog updates via RSS"
                >
                  Subscribe to updates
                </a>
                <a
                  class="bp-share-btn"
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent("https://rentledger.org" + path)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Share on Twitter"
                >
                  Share on X
                </a>
                <button
                  class="bp-share-btn"
                  type="button"
                  id="bp-copy-link"
                  data-url={`https://rentledger.org${path}`}
                  aria-label="Copy link to this article"
                >
                  <span data-default>Copy link</span>
                </button>
              </div>
              <span>Updated {dateModified}</span>
            </footer>

            <p class="bp-byline">
              Written by {author}. Published {datePublished}
              {dateModified !== datePublished && (
                <Fragment> · Updated {dateModified}</Fragment>
              )}.
            </p>
          </article>

          {tocItems.length > 1 && (
            <aside class="bp-toc" aria-label="Table of contents">
              <p class="bp-toc__label">In this article</p>
              <ul class="bp-toc__list" id="bp-toc-list">
                {tocItems.map((item) => (
                  <li class="bp-toc__item" data-target={item.slug}>
                    <a href={`#${item.slug}`}>
                      <span class="bp-toc__num">{item.num}</span>
                      {item.text.replace(/^\d+\.\s+/, "")}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>
      </div>
    ) : (
      <article
        class="container--prose"
        style="padding-top: 8rem; padding-bottom: 5rem;"
      >
        <aside
          class="placeholder-banner"
          style="border: 1px solid var(--rl-border); background: var(--rl-surface); padding: 16px 20px; border-radius: 12px; margin-bottom: 32px;"
        >
          <strong>Draft.</strong> Scaffolded shell. The hand-written
          RentLedger vs {competitor.name} comparison narrative — feature
          matrix, pricing math, privacy posture, migration path — ships
          during the M3.3 comparison sprint.
        </aside>

        <h1>RentLedger vs {competitor.name}</h1>

        <p class="lede">{competitor.tagline}</p>

        <EditorialOnlyNotice competitor={competitor.name} />
        <TaxDisclaimer verifiedDate={today} />

        <h2>At a glance</h2>
        <table>
          <thead>
            <tr>
              <th />
              <th>RentLedger</th>
              <th>{competitor.name}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Platform</strong></td>
              <td>iOS 26+ native</td>
              <td>—</td>
            </tr>
            <tr>
              <td><strong>Pricing</strong></td>
              <td>$4.99/mo · $39.99/yr · $79.99 lifetime</td>
              <td>{competitor.pricingSnapshot}</td>
            </tr>
            <tr>
              <td><strong>Data location</strong></td>
              <td>Local-first, on-device</td>
              <td>—</td>
            </tr>
            <tr>
              <td><strong>Schedule E export</strong></td>
              <td>Yes (PDF + CSV)</td>
              <td>—</td>
            </tr>
            <tr>
              <td><strong>1099-NEC tracking</strong></td>
              <td>Yes</td>
              <td>—</td>
            </tr>
          </tbody>
        </table>

        <p
          style="margin-top: 3rem; color: var(--rl-text-secondary); font-size: 0.875rem;"
        >
          Comparison verified {today}. Pricing on the {competitor.name} side
          changes; verify on
          {
            competitor.sameAs ? (
              <a href={competitor.sameAs}>{competitor.sameAs}</a>
            ) : (
              <span>their site</span>
            )
          } before deciding.
        </p>

        <AuthorQualification />
      </article>
    )
  }

  {
    entry && (
      <script is:inline>
        (function () {
          const bar = document.getElementById("bp-progress-bar");
          if (bar) {
            let ticking = false;
            const update = () => {
              const h = document.documentElement;
              const max = h.scrollHeight - h.clientHeight;
              const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
              bar.style.width = Math.min(100, Math.max(0, pct)) + "%";
              ticking = false;
            };
            document.addEventListener(
              "scroll",
              () => {
                if (!ticking) {
                  window.requestAnimationFrame(update);
                  ticking = true;
                }
              },
              { passive: true },
            );
            update();
          }

          const tocList = document.getElementById("bp-toc-list");
          if (tocList && "IntersectionObserver" in window) {
            const items = Array.from(tocList.querySelectorAll("[data-target]"));
            const targets = items
              .map((li) =>
                document.getElementById(li.getAttribute("data-target")),
              )
              .filter(Boolean);
            const setActive = (id) => {
              items.forEach((li) => {
                const isActive = li.getAttribute("data-target") === id;
                li.classList.toggle("bp-toc__item--active", isActive);
              });
            };
            const io = new IntersectionObserver(
              (entries) => {
                const visible = entries
                  .filter((e) => e.isIntersecting)
                  .sort((a, b) => a.target.offsetTop - b.target.offsetTop);
                if (visible.length > 0) setActive(visible[0].target.id);
              },
              { rootMargin: "0px 0px -70% 0px", threshold: 0 },
            );
            targets.forEach((t) => io.observe(t));
          }

          const copyBtn = document.getElementById("bp-copy-link");
          if (copyBtn) {
            copyBtn.addEventListener("click", async () => {
              const url =
                copyBtn.getAttribute("data-url") || window.location.href;
              try {
                await navigator.clipboard.writeText(url);
                const span = copyBtn.querySelector("[data-default]");
                const prev = span ? span.textContent : null;
                if (span) span.textContent = "Copied";
                copyBtn.setAttribute("data-state", "copied");
                setTimeout(() => {
                  if (span && prev) span.textContent = prev;
                  copyBtn.removeAttribute("data-state");
                }, 1800);
              } catch {
                // Clipboard blocked — silently fail; the URL is in the
                // share-on-X button as a fallback.
              }
            });
          }
        })();
      </script>
    )
  }
</CompareLayout>
