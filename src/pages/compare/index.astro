---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbList from "../../components/schema/BreadcrumbList.astro";
import { competitors } from "../../data/competitors";

const allCompetitors = Object.values(competitors);
const liveCompetitors = allCompetitors.filter((c) => !c.placeholder);
const noindex = liveCompetitors.length === 0;
---

<BaseLayout
  title="Compare RentLedger"
  titleFull="RentLedger vs Competitors — Side-by-Side Comparisons for Landlord Software"
  description="How RentLedger stacks up against every popular rental tracker, accounting platform, and spreadsheet — pricing, Schedule E support, privacy, and platform fit."
  canonicalPath="/compare/"
  noindex={noindex}
>
  <Fragment slot="schema">
    <BreadcrumbList
      items={[{ name: "Home", path: "/" }, { name: "Compare" }]}
    />
  </Fragment>

  <section class="band" style="padding-top: 120px; padding-bottom: 60px;">
    <div class="container" style="max-width: 920px;">
      <span class="section-tag">Side-by-side</span>
      <h1 class="hero-title" style="text-align: left; margin-top: 24px;">
        How RentLedger compares.
      </h1>
      <p class="lede" style="max-width: 680px; margin-top: 24px;">
        Every comparison covers pricing, Schedule E export, privacy posture,
        and where each tool fits best — written by the person who built
        RentLedger, not a generic affiliate page.
      </p>

      {
        liveCompetitors.length === 0 ? (
          <p style="margin-top: 3rem; color: var(--rl-text-secondary);">
            Comparison narratives ship during the M3.3 sprint.
          </p>
        ) : (
          <ul
            style="list-style: none; padding: 0; margin-top: 3rem; display: grid; gap: 1rem;"
          >
            {liveCompetitors.map((c) => (
              <li>
                <a href={`/compare/${c.slug}/`}>RentLedger vs {c.name}</a>
                <p
                  style="color: var(--rl-text-secondary); font-size: 0.9375rem; margin: 0.25rem 0 0;"
                >
                  {c.tagline}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
