---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Product from "../../components/schema/Product.astro";
import FAQPage from "../../components/schema/FAQPage.astro";
import BreadcrumbList from "../../components/schema/BreadcrumbList.astro";
import type { FAQ } from "../../components/schema/FAQPage.astro";

const faqs: FAQ[] = [
  {
    question: "What does the free trial include?",
    answer:
      "Every feature is unlocked during the trial. You're not charged until it ends, and you can cancel anytime in Apple ID settings.",
  },
  {
    question: "How do I cancel?",
    answer:
      "Settings → [Your Name] → Subscriptions → RentLedger → Cancel. Your data stays on your device when a subscription lapses.",
  },
  {
    question: "Can I switch plans later?",
    answer:
      "Yes. Downgrades take effect at the end of the current billing period. Lifetime is a one-time purchase that replaces any active subscription.",
  },
  {
    question: "How do I restore a purchase on a new iPhone?",
    answer:
      'Your subscription or Lifetime purchase is tied to your Apple ID. On a new iPhone, install RentLedger, open Settings in the app, and tap "Restore Purchases." Make sure you\'re signed in to the same Apple ID used for the original purchase.',
  },
  {
    question: 'What does "Lifetime" actually mean?',
    answer:
      "One payment, every future update included, forever. No renewals. No billing emails. If we ever raise prices, your Lifetime stays Lifetime.",
  },
  {
    question: "Do you offer refunds?",
    answer:
      "Refunds go through Apple at reportaproblem.apple.com. We don't process payments directly, so we can't issue them ourselves.",
  },
];

const APP_STORE_URL =
  "https://apps.apple.com/us/app/rentledger-rental-expense-log/id6761083476";
---

<BaseLayout
  title="Pricing"
  titleFull="Pricing — RentLedger | Rental Property Tracker for iOS"
  description="RentLedger pricing: $4.99/month, $39.99/year, or $79.99 lifetime. Same features at every tier. Free trial for new subscribers. Lifetime pays for itself after year 2."
  navActive="pricing"
>
  <Fragment slot="schema">
    <Product />
    <FAQPage faqs={faqs} />
    <BreadcrumbList items={[{ name: "Home", path: "/" }, { name: "Pricing" }]} />
  </Fragment>

  <h1 class="visually-hidden">RentLedger pricing</h1>

  <section class="band band-pricing" style="padding-top: 120px;">
    <div class="container">
      <header class="band-head">
        <span class="section-tag">Pricing</span>
        <h2>Stop managing rentals in spreadsheets</h2>
        <p class="lede">
          Same app, same features, three ways to pay. A free trial unlocks
          everything before you're charged a cent.
        </p>
      </header>
      <div class="plans" data-reveal-group>
        <article class="plan">
          <header>
            <h3>Monthly</h3>
            <div class="price">
              <span class="pcur">$</span><span class="pnum">4.99</span>
            </div>
            <p class="psub">billed monthly</p>
          </header>
          <ul class="pfeat">
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Everything unlocked
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Cancel any month, no lock-in
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Free trial before you're charged
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Ideal if you only need it at tax time
            </li>
          </ul>
          <a class="btn btn-ghost" href={APP_STORE_URL}>Start Free Trial</a>
        </article>
        <article class="plan">
          <header>
            <h3>Annual</h3>
            <div class="price">
              <span class="pcur">$</span><span class="pnum">39.99</span>
            </div>
            <p class="psub">$3.33/mo — <span class="accent">save 33%</span></p>
          </header>
          <ul class="pfeat">
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Everything unlocked
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Save ~$20/yr vs monthly
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Free trial before you're charged
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Best for landlords who track year-round
            </li>
          </ul>
          <a class="btn btn-ghost" href={APP_STORE_URL}>Start Free Trial</a>
        </article>
        <article class="plan plan-feature">
          <span class="ribbon">Best value</span>
          <header>
            <h3>Lifetime</h3>
            <div class="price">
              <span class="pcur">$</span><span class="pnum">79.99</span>
            </div>
            <p class="psub">one-time — pays for itself in year 2</p>
          </header>
          <ul class="pfeat">
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Everything unlocked, forever
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Every future update included
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              Pays for itself after year 2
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l4 4 10-10"></path></svg>
              No renewals, no billing emails, no drama
            </li>
          </ul>
          <a class="btn btn-accent" href={APP_STORE_URL}>Buy Lifetime</a>
        </article>
      </div>
      <p class="legal">
        Free trial available for new subscribers. Subscriptions auto-renew and
        can be canceled anytime via Apple ID settings.
      </p>
    </div>
  </section>

  <section class="band band-tight" style="padding-top: 60px; padding-bottom: 60px;">
    <div class="container">
      <header class="band-head">
        <span class="section-tag">Every plan</span>
        <h2>One feature set. No tiers, no add-ons.</h2>
        <p class="lede">
          Whichever plan you pick, you get the whole app. Pricing is just
          billing cadence.
        </p>
      </header>
      <h3 class="visually-hidden">What every plan includes</h3>
      <ul class="value-grid" data-reveal-group>
        <li class="val-card">
          <span class="val-icn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"></path></svg></span>
          <h4>Unlimited properties</h4>
          <p>Add a duplex, a triplex, or a portfolio of forty. No per-unit fees.</p>
        </li>
        <li class="val-card">
          <span class="val-icn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path></svg></span>
          <h4>Schedule E export</h4>
          <p>The form your CPA actually wants. Or hands to TurboTax in one paste.</p>
        </li>
        <li class="val-card">
          <span class="val-icn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 21V9"></path></svg></span>
          <h4>On-device receipt OCR</h4>
          <p>Apple's Vision framework reads receipts. The image never leaves your phone.</p>
        </li>
        <li class="val-card">
          <span class="val-icn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg></span>
          <h4>1099-NEC vendor totals</h4>
          <p>Year-end totals per vendor, broken out so January isn't a scramble.</p>
        </li>
        <li class="val-card">
          <span class="val-icn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></span>
          <h4>Face ID lock</h4>
          <p>The whole app sits behind your face. Nothing in the cloud to leak.</p>
        </li>
        <li class="val-card">
          <span class="val-icn"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg></span>
          <h4>Every future update</h4>
          <p>New features, tax-form updates, iOS upgrades — included on every plan.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="band band-tight" style="padding-top: 40px;">
    <div class="container">
      <div class="faq-grid">
        <div>
          <span class="section-tag">Pricing FAQ</span>
          <h2>Common questions</h2>
          <p class="lede">
            More answers in <a class="inline-link" href="/support/">Support</a>.
          </p>
        </div>
        <div data-reveal-group>
          {
            faqs.map((faq) => (
              <details>
                <summary>
                  <span>{faq.question}</span>
                  <span class="chev"></span>
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="end-cta">
    <div class="container">
      <h2>Try it before you pay for it.</h2>
      <p class="lede">
        Start the free trial. Add a property, scan a receipt, see if it fits.
        Cancel before it bills if it doesn't.
      </p>
      <a class="btn btn-primary" href={APP_STORE_URL}>Download on the App Store</a>
    </div>
  </section>
</BaseLayout>
