---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbList from "../../components/schema/BreadcrumbList.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  titleFull="RentLedger Blog — Tax, Bookkeeping, and Rental Property Guides"
  description="Tax filing, Schedule E, rental bookkeeping, and landlord guides — written by Praneet Soni, founder of RentLedger."
  canonicalPath="/blog/"
  noindex={posts.length === 0}
>
  <Fragment slot="schema">
    <BreadcrumbList items={[{ name: "Home", path: "/" }, { name: "Blog" }]} />
  </Fragment>

  <section class="band" style="padding-top: 120px; padding-bottom: 60px;">
    <div class="container" style="max-width: 920px;">
      <span class="section-tag">Blog</span>
      <h1 class="hero-title" style="text-align: left; margin-top: 24px;">
        Tax and bookkeeping guides for landlords.
      </h1>
      <p class="lede" style="max-width: 680px; margin-top: 24px;">
        Written by <a class="inline-link" href="/about/">Praneet Soni</a>,
        founder of RentLedger. Schedule E walk-throughs, deduction guides,
        and the bookkeeping reality at every portfolio scale.
      </p>

      {
        posts.length === 0 ? (
          <p style="margin-top: 3rem; color: var(--rl-text-secondary);">
            First post lands soon.{" "}
            <a class="inline-link" href="/blog/rss.xml">
              Subscribe to the RSS feed
            </a>{" "}
            to know when.
          </p>
        ) : (
          <ul
            style="list-style: none; padding: 0; margin-top: 3rem; display: grid; gap: 2rem;"
          >
            {posts.map((post) => (
              <li
                style="border-top: 1px solid var(--rl-border); padding-top: 2rem;"
              >
                <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p
                  style="color: var(--rl-text-secondary); margin-bottom: 0.75rem;"
                >
                  {post.data.description}
                </p>
                <small
                  style="color: var(--rl-text-secondary); font-family: var(--font-mono);"
                >
                  {post.data.pubDate.toISOString().slice(0, 10)}
                  {post.data.tags.length > 0 && (
                    <> · {post.data.tags.join(", ")}</>
                  )}
                </small>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
