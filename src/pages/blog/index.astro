---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbList from "../../components/schema/BreadcrumbList.astro";
import { getCollection } from "astro:content";
import "../../styles/blog-post.css";

// Index page for /blog/. Drops the marketing-site type styles in favor of
// the editorial template's Newsreader + IBM Plex stack, so navigating
// from the index → a post → back feels typographically continuous.
// Each post row shows a mono date + tag + reading-time chip rail above the
// serif title link. Reading time is computed at build time from post body.
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => {
    const wordCount = post.body
      ? Math.max(1, Math.round(post.body.length / 5))
      : 0;
    const readingMinutes = Math.max(1, Math.round(wordCount / 220));
    return {
      ...post,
      readingMinutes,
    };
  });

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const primaryTag = (tags: string[]) => {
  if (!tags || tags.length === 0) return null;
  const skip = new Set(["2026", "2025", "2024"]);
  return tags.find((t) => !skip.has(t)) ?? tags[0];
};
---

<BaseLayout
  title="Blog"
  titleFull="RentLedger Blog — Tax, Bookkeeping, and Rental Property Guides"
  description="Tax filing, Schedule E, rental bookkeeping, and landlord guides — written by Praneet Soni, founder of RentLedger."
  canonicalPath="/blog/"
  navActive="blog"
  noindex={posts.length === 0}
>
  <Fragment slot="schema">
    <BreadcrumbList items={[{ name: "Home", path: "/" }, { name: "Blog" }]} />
  </Fragment>

  <section class="blog-index">
    <span class="blog-index__eyebrow">Blog</span>
    <h1 class="blog-index__title">
      Tax and bookkeeping guides for landlords.
    </h1>
    <p class="blog-index__lede">
      Written by <a href="/about/">Praneet Soni</a>, founder of RentLedger.
      Schedule E walk-throughs, deduction guides, original-source statistics,
      and the bookkeeping reality at every portfolio scale.
    </p>

    {
      posts.length === 0 ? (
        <p class="blog-index__empty">
          First post lands soon.{" "}
          <a href="/blog/rss.xml">Subscribe to the RSS feed</a> to know when.
        </p>
      ) : (
        <Fragment>
          <p class="blog-index__list-label">Latest</p>
          <ul class="blog-index__list">
            {posts.map((post) => {
              const tag = primaryTag(post.data.tags);
              return (
                <li class="blog-index__post">
                  <p class="blog-index__post-meta">
                    <span class="blog-index__post-date">
                      {formatDate(post.data.pubDate)}
                    </span>
                    {tag && (
                      <span class="blog-index__post-tag">{tag}</span>
                    )}
                    <span class="blog-index__post-readtime">
                      {post.readingMinutes} min
                    </span>
                  </p>
                  <h2 class="blog-index__post-title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                  <p class="blog-index__post-desc">{post.data.description}</p>
                  <a class="blog-index__post-cta" href={`/blog/${post.id}/`}>
                    Read article
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </Fragment>
      )
    }
  </section>
</BaseLayout>
