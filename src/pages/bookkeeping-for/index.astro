---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbList from "../../components/schema/BreadcrumbList.astro";
import { scales } from "../../data/unit-counts";

const allScales = Object.values(scales);
const liveScales = allScales.filter((s) => !s.placeholder);
const noindex = liveScales.length === 0;
---

<BaseLayout
  title="Bookkeeping for landlords"
  titleFull="Bookkeeping for Landlords — How Real Landlords Track Rentals at Every Scale"
  description="How landlords actually keep their books — from a single property to a portfolio of ten. Workflow, time budget, tooling cost, and when a bookkeeper pays for itself."
  canonicalPath="/bookkeeping-for/"
  noindex={noindex}
>
  <Fragment slot="schema">
    <BreadcrumbList
      items={[
        { name: "Home", path: "/" },
        { name: "Bookkeeping for landlords" },
      ]}
    />
  </Fragment>

  <section class="band" style="padding-top: 120px; padding-bottom: 60px;">
    <div class="container" style="max-width: 920px;">
      <span class="section-tag">By portfolio scale</span>
      <h1 class="hero-title" style="text-align: left; margin-top: 24px;">
        Bookkeeping for landlords, at every portfolio scale.
      </h1>
      <p class="lede" style="max-width: 680px; margin-top: 24px;">
        How much time bookkeeping really takes, what tools work at each
        scale, and the actual math on hiring a bookkeeper.
      </p>

      {
        liveScales.length === 0 ? (
          <p style="margin-top: 3rem; color: var(--rl-text-secondary);">
            Scale-specific guides ship during the M3.3 pilot.
          </p>
        ) : (
          <ul
            style="list-style: none; padding: 0; margin-top: 3rem; display: grid; gap: 1rem;"
          >
            {liveScales.map((s) => (
              <li>
                <a href={`/bookkeeping-for/${s.slug}-rentals/`}>
                  Bookkeeping for {s.name.toLowerCase()}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
