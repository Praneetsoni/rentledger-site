---
import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Organization from "../components/schema/Organization.astro";
import WebSite from "../components/schema/WebSite.astro";

export interface Props {
  title: string;
  titleFull?: string;
  description: string;
  keywords?: string;
  canonicalPath?: string;
  preloadImage?: string;
  noindex?: boolean;
  navActive?: "home" | "pricing" | "about" | "support";
}

const {
  title,
  titleFull,
  description,
  keywords,
  canonicalPath,
  preloadImage,
  noindex,
  navActive,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      titleFull={titleFull}
      description={description}
      keywords={keywords}
      canonicalPath={canonicalPath}
      preloadImage={preloadImage}
      noindex={noindex}
    >
      <slot name="schema" slot="schema" />
    </BaseHead>
    <Organization />
    <WebSite />
  </head>
  <body>
    <Nav active={navActive} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script src="/assets/js/reveals.js" is:inline defer></script>
  </body>
</html>
