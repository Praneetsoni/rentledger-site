---
import BaseLayout from "./BaseLayout.astro";
import Article from "../components/schema/Article.astro";
import HowTo from "../components/schema/HowTo.astro";
import Person from "../components/schema/Person.astro";
import FAQPage from "../components/schema/FAQPage.astro";
import BreadcrumbList from "../components/schema/BreadcrumbList.astro";
import type { FAQ } from "../components/schema/FAQPage.astro";
import type { HowToStep } from "../components/schema/HowTo.astro";

export interface Props {
  /** Article title — also used as <title>. */
  title: string;
  /** Optional full <title> override. */
  titleFull?: string;
  /** Used as <meta description> AND Article.description. */
  description: string;
  keywords?: string;
  /** Path relative to site root. Defaults to current route. */
  canonicalPath?: string;
  /** Hero image URL relative to site root, e.g. "/images/blog/foo-hero.webp".
   * Used for OG preview AND Article.image. */
  heroImage?: string;
  /** ISO date (YYYY-MM-DD) — when the article was first published. */
  datePublished: string;
  /** ISO date (YYYY-MM-DD) — when the article was last edited or its
   * VerifiedField data was re-verified. */
  dateModified: string;
  /** True when Praneet has spot-checked the data per §12.3. */
  reviewed?: boolean;
  /** FAQs rendered on the page AND emitted as FAQPage JSON-LD. Per §11.6,
   * every blog page should ship 4–8 entity-linked FAQs. */
  faqs?: FAQ[];
  /** Breadcrumb trail. The current page's name is the last item without a path. */
  breadcrumbs?: { name: string; path?: string }[];
  /** True for placeholder programmatic pages and drafts. Sets robots
   * meta to noindex,nofollow so unfinished pages don't leak into Google. */
  noindex?: boolean;
  /**
   * Per SEO-PLAYBOOK §M1.3 frontmatter spec: override the default schema
   * type emitted by the layout. Default `Article` covers ~95% of blog
   * posts. Use `HowTo` for genuine step-by-step guides — requires `steps`.
   */
  schemaType?: "Article" | "HowTo";
  /** Required when schemaType === "HowTo". */
  steps?: HowToStep[];
}

const {
  title,
  titleFull,
  description,
  keywords,
  canonicalPath,
  heroImage,
  datePublished,
  dateModified,
  reviewed = false,
  faqs,
  breadcrumbs,
  noindex,
  schemaType = "Article",
  steps,
} = Astro.props;

if (schemaType === "HowTo" && (!steps || steps.length === 0)) {
  throw new Error(
    `BlogLayout: schemaType="HowTo" requires non-empty steps[]. Add steps to the post frontmatter or use the default Article type.`,
  );
}

---

<BaseLayout
  title={title}
  titleFull={titleFull}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  preloadImage={heroImage}
  noindex={noindex}
>
  <Fragment slot="schema">
    {
      schemaType === "HowTo" ? (
        <HowTo name={title} description={description} steps={steps!} />
      ) : (
        <Article
          headline={title}
          description={description}
          pagePath={canonicalPath}
          datePublished={datePublished}
          dateModified={dateModified}
          image={heroImage}
          reviewed={reviewed}
        />
      )
    }
    <Person mode="inline" />
    {faqs && faqs.length > 0 && <FAQPage faqs={faqs} />}
    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <BreadcrumbList items={breadcrumbs} />
      )
    }
  </Fragment>

  <slot />
</BaseLayout>
