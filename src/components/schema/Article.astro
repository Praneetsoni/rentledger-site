---
import { SCHEMA_IDS, SITE_URL } from "./ids";

// Per Schema.org spec, Article.reviewedBy is for an INDEPENDENT reviewer
// (someone other than the author). Emitting reviewedBy that points to the
// same Person as Article.author is structured-data misrepresentation:
// "this article was reviewed by an independent party" → "Praneet reviewed
// his own article." Per SEO-PLAYBOOK §12.7.10 schema sanity rules + PR #7
// legal audit P2-4.
//
// Until a real CPA reviewer is engaged, we DO NOT emit reviewedBy at all.
// When a CPA reviewer reviews a page, the page passes a `cpaReviewer`
// payload — only then is reviewedBy emitted, pointing to the CPA's
// independent Person @id.

interface CpaReviewer {
  /** CPA's full name as it should appear in schema. */
  name: string;
  /** Stable @id URI for the CPA Person — typically a section anchor on
   * /about/ or a dedicated reviewer page. */
  personId: string;
  /** Optional canonical URL for the CPA's profile (e.g., AICPA listing). */
  url?: string;
  /** ISO 8601 date of review. */
  reviewDate: string;
}

interface Props {
  headline: string;
  description: string;
  /** Path relative to site root, e.g. "/blog/schedule-e-for-airbnb/". Defaults to current route. */
  pagePath?: string;
  /** ISO 8601 datetime (e.g., "2026-04-28T00:00:00.000Z") — when the article
   * was first published. Google Rich Results requires the timezone offset;
   * date-only YYYY-MM-DD triggers a non-critical warning. */
  datePublished: string;
  /** ISO 8601 datetime (with timezone) — when the article was last
   * meaningfully edited or when the most recent VerifiedField was
   * re-verified. */
  dateModified: string;
  /** Hero image URL relative to site root, e.g. "/images/blog/foo-hero.webp". */
  image?: string;
  /** Independent CPA reviewer payload. Only set when a licensed CPA has
   * actually reviewed the article. Emits Article.reviewedBy pointing to
   * the CPA's Person @id. */
  cpaReviewer?: CpaReviewer;
}

const {
  headline,
  description,
  pagePath,
  datePublished,
  dateModified,
  image,
  cpaReviewer,
} = Astro.props;

const path = pagePath ?? Astro.url.pathname;

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline,
  description,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${path}` },
  datePublished,
  dateModified,
  ...(image ? { image: `${SITE_URL}${image}` } : {}),
  author: { "@id": SCHEMA_IDS.person },
  publisher: { "@id": SCHEMA_IDS.organization },
  ...(cpaReviewer
    ? {
        reviewedBy: {
          "@type": "Person",
          "@id": cpaReviewer.personId,
          name: cpaReviewer.name,
          ...(cpaReviewer.url ? { url: cpaReviewer.url } : {}),
        },
      }
    : {}),
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(article)}
/>
