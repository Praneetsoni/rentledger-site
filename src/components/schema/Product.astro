---
import { APP_STORE_URL } from "./ids";

const product = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "RentLedger Premium",
  description:
    "Premium subscription for RentLedger — the rental property tracker for iOS. Unlocks tax reports, receipt scanning, CSV export, and all future features.",
  brand: { "@type": "Brand", name: "RentLedger" },
  offers: [
    {
      "@type": "Offer",
      name: "Monthly Subscription",
      price: "4.99",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: APP_STORE_URL,
    },
    {
      "@type": "Offer",
      name: "Annual Subscription",
      price: "39.99",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: APP_STORE_URL,
    },
    {
      "@type": "Offer",
      name: "Lifetime Purchase",
      price: "79.99",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: APP_STORE_URL,
    },
  ],
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(product)}
/>
