---
import { SCHEMA_IDS, SITE_URL } from "./ids";

interface Props {
  /** Headline of the review/comparison page, e.g. "RentLedger vs Stessa". */
  name: string;
  /** Page path, e.g. "/compare/stessa/". Defaults to current route. */
  pagePath?: string;
  /** ISO date (YYYY-MM-DD) — when the review was first published. */
  datePublished: string;
  /** ISO date (YYYY-MM-DD) — when the review was last meaningfully edited
   * or when the most recent VerifiedField was re-verified. */
  dateModified: string;
  /**
   * Per SEO-PLAYBOOK §11.6: every /compare/* page is a Review of RentLedger
   * itself (the comparison context = our app, evaluated against the
   * competitor named in `about`). `itemReviewed` resolves to the canonical
   * MobileApplication @id rather than re-stating the app on every page.
   * The competitor identity flows through `about` so the Review still
   * carries the comparison entity in its graph.
   */
  competitor?: {
    name: string;
    sameAs?: string;
  };
  /** Optional rating block — only emit when honest, sourced rating is available. */
  reviewRating?: {
    ratingValue: number;
    bestRating?: number;
    worstRating?: number;
  };
  /** Body of the review for `reviewBody` field. */
  reviewBody: string;
}

const {
  name,
  pagePath,
  datePublished,
  dateModified,
  competitor,
  reviewRating,
  reviewBody,
} = Astro.props;

const path = pagePath ?? Astro.url.pathname;

const review = {
  "@context": "https://schema.org",
  "@type": "Review",
  name,
  url: `${SITE_URL}${path}`,
  datePublished,
  dateModified,
  itemReviewed: { "@id": SCHEMA_IDS.mobileApplication },
  ...(competitor
    ? {
        about: {
          "@type": "SoftwareApplication",
          name: competitor.name,
          applicationCategory: "FinanceApplication",
          ...(competitor.sameAs ? { sameAs: [competitor.sameAs] } : {}),
        },
      }
    : {}),
  author: { "@id": SCHEMA_IDS.person },
  publisher: { "@id": SCHEMA_IDS.organization },
  reviewBody,
  ...(reviewRating
    ? {
        reviewRating: {
          "@type": "Rating",
          ratingValue: reviewRating.ratingValue,
          bestRating: reviewRating.bestRating ?? 5,
          worstRating: reviewRating.worstRating ?? 1,
        },
      }
    : {}),
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(review)}
/>
