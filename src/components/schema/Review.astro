---
import { SCHEMA_IDS, SITE_URL } from "./ids";

interface Props {
  /** Headline of the review/comparison page, e.g. "RentLedger vs Stessa". */
  name: string;
  /** Page path, e.g. "/compare/stessa/". Defaults to current route. */
  pagePath?: string;
  /** ISO date (YYYY-MM-DD) — when the review was first published. */
  datePublished: string;
  /** ISO date (YYYY-MM-DD) — when the review was last meaningfully edited
   * or when the most recent VerifiedField was re-verified. */
  dateModified: string;
  /** What's being reviewed. For /compare/* this is the canonical RentLedger
   * MobileApplication node — pass `selfReview = true` to use the @id ref. */
  selfReview?: boolean;
  /** When `selfReview` is false, supply the competitor's name and an optional
   * sameAs URL to identify them. */
  competitor?: {
    name: string;
    sameAs?: string;
  };
  /** Optional rating block — only emit when honest, sourced rating is available. */
  reviewRating?: {
    ratingValue: number;
    bestRating?: number;
    worstRating?: number;
  };
  /** Body of the review for `reviewBody` field. */
  reviewBody: string;
}

const {
  name,
  pagePath,
  datePublished,
  dateModified,
  selfReview = false,
  competitor,
  reviewRating,
  reviewBody,
} = Astro.props;

const path = pagePath ?? Astro.url.pathname;

const itemReviewed = selfReview
  ? { "@id": SCHEMA_IDS.mobileApplication }
  : {
      "@type": "SoftwareApplication",
      name: competitor?.name ?? "Unknown",
      applicationCategory: "FinanceApplication",
      ...(competitor?.sameAs ? { sameAs: [competitor.sameAs] } : {}),
    };

const review = {
  "@context": "https://schema.org",
  "@type": "Review",
  name,
  url: `${SITE_URL}${path}`,
  datePublished,
  dateModified,
  itemReviewed,
  author: { "@id": SCHEMA_IDS.person },
  publisher: { "@id": SCHEMA_IDS.organization },
  reviewBody,
  ...(reviewRating
    ? {
        reviewRating: {
          "@type": "Rating",
          ratingValue: reviewRating.ratingValue,
          bestRating: reviewRating.bestRating ?? 5,
          worstRating: reviewRating.worstRating ?? 1,
        },
      }
    : {}),
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(review)}
/>
