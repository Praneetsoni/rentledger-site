---
import Fonts from "./Fonts.astro";
import "../styles/site.css";

export interface Props {
  /** Used as <title> directly when titleFull is not provided; appended with " — RentLedger" */
  title: string;
  /** Full title override — used verbatim. Bypasses the " — RentLedger" suffix. */
  titleFull?: string;
  description: string;
  keywords?: string;
  /** Path relative to site root, e.g. "/pricing/". Defaults to current Astro.url.pathname. */
  canonicalPath?: string;
  /** Used as <link rel="preload" as="image">, e.g. "/assets/img/screens/hero-phone-center.webp" */
  preloadImage?: string;
  noindex?: boolean;
}

const {
  title,
  titleFull,
  description,
  keywords,
  canonicalPath,
  preloadImage,
  noindex = false,
} = Astro.props;

const SITE_URL = "https://rentledger.org";
const path = canonicalPath ?? Astro.url.pathname;
const canonical = `${SITE_URL}${path}`;
const renderedTitle = titleFull ?? `${title} — RentLedger`;
const ogImage = `${SITE_URL}/og-image.webp`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#0F0F14" />
<meta
  name="robots"
  content={noindex
    ? "noindex,nofollow"
    : "index,follow,max-snippet:-1,max-image-preview:large"}
/>

<title>{renderedTitle}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}

<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="apple-itunes-app" content="app-id=6761083476" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="RentLedger" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={renderedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="RentLedger — Rental property tracker for landlords on iOS"
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={renderedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      fetchpriority="high"
    />
  )
}

<Fonts />

<slot name="schema" />
