---
// Canonical tax-advice disclaimer per SEO-PLAYBOOK §12.7.1.
// Renders the verbatim safe-harbor block on every YMYL page (any page
// making tax/legal/financial-decision claims). Wording is calibrated to
// disclaim personalized advice without disclaiming educational utility,
// and to defeat any "implicit endorsement by author's apparent expertise"
// claim by naming the publisher (Praneet Soni) explicitly.
//
// Presentation discipline (§12.7.1.1, added 2026-05-02 per Praneet
// directive): the disclaimer must remain above the fold (clear-and-
// conspicuous test under FTC Endorsement Guides + state consumer-
// protection statutes), but ships as a compact pill-summary with a
// <details>-based expansion to the full prose. The summary line itself
// asserts the headline disclaimer ("Educational, not personalized
// advice") so a non-expanding reader still sees the safe-harbor framing.
// The full prose remains a single click away — which is the standard
// the courts apply (Williams v. Gerber, FTC v. Cyberspace.com): a
// reasonable reader could find it. Page-level paraphrasing is forbidden
// by §12.7.1 — keep this the single source of truth.
//
// Publisher framing: until RentLedger is registered as an LLC, the
// publisher of record is "Praneet Soni" personally, doing business as
// RentLedger. When the LLC is formed, swap the publisher string in this
// component (and AuthorQualification + EditorialOnlyNotice) to
// "[LLC name] (operator of RentLedger), and its founder Praneet Soni."
// Per §12.7.1 + Q28 deferred-LLC clause.

interface Props {
  /** ISO date the underlying VerifiedFields were last verified. */
  verifiedDate: string;
  /**
   * Authoritative URL the reader should consult to verify figures and
   * rules. Defaults to IRS Publication 527 (Residential Rental Property)
   * for federal-content pages. State pages should override OR import
   * `StateTaxDisclaimer` instead.
   */
  authoritativeSource?: string;
  /** Optional human-readable label for the source link. */
  authoritativeSourceLabel?: string;
}

const {
  verifiedDate,
  authoritativeSource = "https://www.irs.gov/forms-pubs/about-publication-527",
  authoritativeSourceLabel = "IRS Publication 527",
} = Astro.props;
---

<details class="tax-disclaimer" aria-label="Editorial disclaimer">
  <summary class="tax-disclaimer__summary">
    <span class="tax-disclaimer__pill" aria-hidden="true">Editorial</span>
    <span class="tax-disclaimer__headline">
      <strong>Educational, not personalized tax advice.</strong>
      Verified <time datetime={verifiedDate}>{verifiedDate}</time>; consult a
      CPA before filing.
    </span>
    <span class="tax-disclaimer__chevron" aria-hidden="true">Read full</span>
  </summary>
  <div class="tax-disclaimer__body">
    <p>
      <strong>General educational information — not personalized advice.</strong>
    </p>
    <p>
      This article provides general educational information about U.S. federal
      tax topics for residential rental property owners. It is <strong>not
        personalized tax, legal, or accounting advice</strong>, and reading it
      does not create any professional-client relationship between you and
      Praneet Soni (publisher of RentLedger). Tax laws change frequently,
      individual circumstances vary, and a CPA, Enrolled Agent, or tax
      attorney licensed in your jurisdiction is the only appropriate party
      to advise on your specific filing decisions.
    </p>
    <p>
      Figures and rules are current as of
      <time datetime={verifiedDate}>{verifiedDate}</time>; verify against
      <a href={authoritativeSource} rel="external"
        >{authoritativeSourceLabel}</a
      > before relying on anything here. Content is provided <strong
        >"as is"</strong
      > without warranty of accuracy, completeness, or timeliness. Praneet
      Soni is not a licensed tax professional and is not liable for any
      decision made in reliance on this content.
    </p>
  </div>
</details>

<style>
  .tax-disclaimer {
    margin: 24px 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--rl-text-secondary);
    border: 1px solid var(--rl-border);
    background: var(--rl-surface);
    border-radius: 999px;
    transition:
      border-radius 0.18s ease,
      background 0.18s ease;
  }
  .tax-disclaimer[open] {
    border-radius: 12px;
    background: var(--rl-surface);
  }

  .tax-disclaimer__summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .tax-disclaimer__summary::-webkit-details-marker {
    display: none;
  }
  .tax-disclaimer__summary:hover .tax-disclaimer__chevron {
    color: var(--rl-text);
  }

  .tax-disclaimer__pill {
    flex: 0 0 auto;
    background: var(--rl-text);
    color: var(--rl-bg);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .tax-disclaimer__headline {
    flex: 1 1 auto;
    color: var(--rl-text-secondary);
    font-size: 13px;
  }
  .tax-disclaimer__headline strong {
    color: var(--rl-text);
    font-weight: 600;
  }
  .tax-disclaimer__headline time {
    font-variant-numeric: tabular-nums;
  }

  .tax-disclaimer__chevron {
    flex: 0 0 auto;
    font-size: 12px;
    color: var(--rl-text-secondary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .tax-disclaimer[open] .tax-disclaimer__chevron::after {
    content: " ↑";
  }
  .tax-disclaimer:not([open]) .tax-disclaimer__chevron::after {
    content: " ↓";
  }

  .tax-disclaimer__body {
    padding: 4px 24px 20px;
    border-top: 1px solid var(--rl-border);
  }
  .tax-disclaimer__body p {
    margin: 12px 0;
  }
  .tax-disclaimer__body p:first-child {
    margin-top: 16px;
  }
  .tax-disclaimer__body p:last-child {
    margin-bottom: 0;
  }
  .tax-disclaimer__body a {
    color: var(--rl-text);
    text-decoration: underline;
  }

  @media (max-width: 540px) {
    .tax-disclaimer__summary {
      flex-wrap: wrap;
      padding: 10px 14px 10px 8px;
    }
    .tax-disclaimer__chevron {
      width: 100%;
      text-align: right;
    }
  }
</style>
